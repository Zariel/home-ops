{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>home-operations/renovate-presets',
    'github>home-operations/renovate-presets//apps/cnpg.json5',
    'github>zariel/home-ops//.renovate/allowedVersions.json5',
    'github>zariel/home-ops//.renovate/autoMerge.json5',
    'github>zariel/home-ops//.renovate/customManagers.json5',
    'github>zariel/home-ops//.renovate/grafanaDashboards.json5',
    'github>zariel/home-ops//.renovate/groups.json5',
    'github>zariel/home-ops//.renovate/labels.json5',
    ':semanticCommits',
    ':timezone(Europe/London)',
  ],
  suppressNotifications: [
    'prEditedNotification',
    'prIgnoreNotification',
  ],
  ignorePaths: [
    '**/*.sops.*',
    '**/resources/**',
    '**/ansible/**',
  ],
  nix: {
    enabled: true,
  },
  packageRules: [
    {
      description: 'Keep VectorChord images compatible with the PostgreSQL major version',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/tensorchord/vchord-scratch'],
      matchCurrentValue: '/^pg\\d+-v/',
      versioning: 'regex:^(?<compatibility>pg\\d+)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      description: 'Limit NetBox updates to the weekly Monday maintenance window',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/netbox-community/netbox-chart/netbox'],
      schedule: ['* 5 * * 1'],
      automergeSchedule: ['* 5 * * 1'],
      platformAutomerge: false,
      updateNotScheduled: false,
    },
    {
      // Docker-based GitHub Actions from GHCR may not expose release timestamps,
      // which can leave updates permanently pending when minimumReleaseAge is set.
      matchManagers: ["github-actions"],
      matchDatasources: ["docker"],
      minimumReleaseAge: "0 days",
    },
    {
      matchPackageNames: ["home-operations/flate", "home-operations/flate/action"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "0 days",
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: 'Require review for potentially breaking 0.x minor updates',
      matchUpdateTypes: ['minor'],
      matchCurrentVersion: '/^v?0\\./',
      automerge: false,
    },
  ],
}
