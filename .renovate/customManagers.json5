{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "description": ["Katl release for OS and PXE artifacts"],
      "managerFilePatterns": ["/^katl/version$/"],
      "matchStrings": ["(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z]+\\.[0-9]+)?)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "katl-dev/katl",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": ["Katl CLI release pinned in the development flake"],
      "managerFilePatterns": ["/^flake\\.nix$/"],
      "matchStrings": ["katl\\.url = \"github:katl-dev/katl/v(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z]+\\.[0-9]+)?)\""],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "katl-dev/katl",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": ["Upstream Kubernetes version published for Katl"],
      "managerFilePatterns": ["/^katl/cluster\\.yaml$/"],
      "matchStrings": ["kubernetes:\\n    version: (?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/katl-dev/kubernetes",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": ["Process annotated URL dependencies"],
      "managerFilePatterns": [
        "/(^|/)k8s/.+\\.ya?ml(\\.j2)?$/",
      ],
      "matchStrings": [
        // # renovate: datasource=github-releases depName=rancher/system-upgrade-controller
        // https://github.com/rancher/system-upgrade-controller/releases/download/v0.13.2/crd.yaml
        "(?m:# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n.+?\/(?<currentValue>(v|\\d)[^\/]+)\\S+$)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}"
    }
  ],
  "packageRules": [
    {
      "description": "Track Katl release tags with the custom manager instead of commit updates",
      "matchManagers": ["nix"],
      "matchPackageNames": ["https://github.com/katl-dev/katl"],
      "enabled": false
    },
    {
      "description": "Refresh the Katl lock entry after updating release pins",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["katl-dev/katl"],
      "postUpgradeTasks": {
        "commands": ["nix --extra-experimental-features 'nix-command flakes' flake update katl"],
        "installTools": {"nix": {}},
        "fileFilters": ["flake.lock"],
        "executionMode": "branch"
      }
    },
    {
      "description": ["Refresh vendored Forgejo Catppuccin theme CSS"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["catppuccin/gitea"],
      "postUpgradeTasks": {
        "commands": [
          ".renovate/scripts/update-catppuccin-gitea.sh"
        ],
        "fileFilters": [
          "k8s/apps/forgejo-system/forgejo/app/themes/theme-catppuccin-mocha-lavender.css"
        ],
        "executionMode": "update"
      }
    }
  ]
}
