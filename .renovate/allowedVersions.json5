{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Only allow stable Ceph releases (x.2.z)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/ceph/ceph"],
      "allowedVersions": "/^v?\\d+\\.2\\.\\d+$/"
    },
    {
      "matchDatasources": ["docker"],
      "allowedVersions": "<999",
      "matchPackageNames": ["/kopia/"]
    },
    {
      "description": "Keep CNPG on PostgreSQL 18 while allowing maintenance releases",
      "matchDatasources": ["docker"],
      "allowedVersions": "<19",
      "matchPackageNames": ["ghcr.io/cloudnative-pg/postgresql"]
    }
  ]
}
