{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": [
        "Auto-merge container updates for trusted containers"
      ],
      "matchDatasources": [
        "docker"
      ],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
      "matchUpdateTypes": ["digest", "minor", "patch"],
      "matchPackageNames": [
        "/ghcr.io/bjw-s/",
        "/ghcr.io/onedr0p/",
        "/ghcr.io/zariel/",
        "/ghcr.io/home-operations/",
        "ghcr.io/renovatebot/renovate",
        "/ghcr.io/cross-seed/cross-seed/",
        "/docker.io/filebrowser/filebrowser/"
      ]
    },
    {
      "description": "Auto-merge LinuxServer image digest updates",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "lscr.io/linuxserver/**",
        "ghcr.io/linuxserver/**",
        "docker.io/linuxserver/**",
        "linuxserver/**"
      ],
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
    },
    {
      "description": "Auto-merge OCI Charts",
      "matchDatasources": ["docker"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": [
        "/ghcr.io/prometheus-community/charts/",
        "ghcr.io/grafana-community/helm-charts/grafana",
        "/ghcr.io/netbox-community/netbox-chart/netbox/"
      ],
      "ignoreTests": false,
    },
    {
      "description": "Auto-merge GitHub Actions",
      "matchManagers": ["github-actions"],
      "automerge": true,
      "automergeType": "pr",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "ignoreTests": false,
    },
    {
      "description": [
        "dont auto merge qbittorrent updates until clients are allowed"
      ],
      "matchDatasources": [
        "docker"
      ],
      "automerge": false,
      "addLabels": ["do-not-merge"],
      "matchPackageNames": [
        "ghcr.io/home-operations/qbittorrent",
        "ghcr.io/home-operations/qbittorrent-libtorrentv1"
      ]
    },
    {
      description: ["auto merge grafana dashboards"],
      matchDatasources: ["custom.grafana-dashboards"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
  ]
}
