{
  "title": "Cilium / Network policy",
  "uid": "network-policy",
  "description": "Workload dependencies and policy drops from Hubble. Internet destinations and connections opened before metrics began are not recorded.",
  "tags": [
    "cilium",
    "hubble",
    "network-policy"
  ],
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {
          "text": "VictoriaMetrics",
          "value": "victoriametrics"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(hubble_flows_processed_total, source_namespace)",
        "query": {
          "query": "label_values(hubble_flows_processed_total, source_namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "app",
        "label": "App",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(hubble_port_distribution_total{source_namespace=~\"$namespace\"}, source_app)",
        "query": {
          "query": "label_values(hubble_port_distribution_total{source_namespace=~\"$namespace\"}, source_app)",
          "refId": "app"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pods without policy",
      "description": "Cluster pods that enforce no network policy in either direction",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "expr": "sum(max by (node) (cilium_policy_endpoint_enforcement_status{enforcement=\"none\"}))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pods with policy",
      "description": "Cluster pods that enforce network policy on ingress, egress or both",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "expr": "sum(max by (node, enforcement) (cilium_policy_endpoint_enforcement_status{enforcement=~\"ingress|egress|both\"}))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Missing-rule drops",
      "description": "Connections no policy allowed, excluding ICMP errors, for the selected apps",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "expr": "sum(increase(hubble_drop_total{source_namespace=~\"$namespace\", source_app=~\"$app\", reason=\"POLICY_DENIED\", protocol!~\"ICMP.*\"}[$__range]) or increase(hubble_drop_total{destination_namespace=~\"$namespace\", destination_app=~\"$app\", reason=\"POLICY_DENIED\", protocol!~\"ICMP.*\"}[$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Sustained denials",
      "description": "Peer pairs with missing-rule drops in at least 8 of the last 12 five-minute windows",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "expr": "count(count_over_time((sum by (source_namespace, source_app, source, destination_namespace, destination_app, destination, traffic_direction) (increase(hubble_drop_total{reason=\"POLICY_DENIED\", protocol!~\"ICMP.*\"}[5m])) > 0)[1h:5m]) >= 8)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Explicit denies",
      "description": "Drops from deliberate deny rules for the selected apps",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8a8a8a"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "expr": "sum(increase(hubble_drop_total{source_namespace=~\"$namespace\", source_app=~\"$app\", reason=\"POLICY_DENY\"}[$__range]) or increase(hubble_drop_total{destination_namespace=~\"$namespace\", destination_app=~\"$app\", reason=\"POLICY_DENY\"}[$__range]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "New connections",
      "description": "Connections opened by the selected apps, excluding internet destinations",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "fixed",
