      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "expr": "sum(increase(hubble_port_distribution_total{traffic_direction=\"egress\", source_namespace=~\"$namespace\", source_app=~\"$app\"}[$__range]))"
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Denials",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "bargauge",
      "title": "Missing-rule drops by peer pair",
      "description": "Largest sources of connections no policy allowed, excluding ICMP errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No missing-rule drops",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "instant": true,
          "legendFormat": "{{traffic_direction}} {{source_namespace}}/{{source_app}}{{source}} \u2192 {{destination_namespace}}/{{destination_app}}{{destination}}",
          "expr": "topk(10, sum by (traffic_direction, source_namespace, source_app, source, destination_namespace, destination_app, destination) (increase(hubble_drop_total{source_namespace=~\"$namespace\", source_app=~\"$app\", reason=\"POLICY_DENIED\", protocol!~\"ICMP.*\"}[$__range]) or increase(hubble_drop_total{destination_namespace=~\"$namespace\", destination_app=~\"$app\", reason=\"POLICY_DENIED\", protocol!~\"ICMP.*\"}[$__range])) > 0)"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Missing-rule drops by source app",
      "description": "Hourly connections no policy allowed, excluding ICMP errors",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "interval": "1h",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "noValue": "No missing-rule drops",
          "custom": {
            "drawStyle": "bars",
            "barAlignment": 1,
            "fillOpacity": 85,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{source_namespace}}/{{source_app}}{{source}}",
          "expr": "sum by (source_namespace, source_app, source) (increase(hubble_drop_total{source_namespace=~\"$namespace\", source_app=~\"$app\", reason=\"POLICY_DENIED\", protocol!~\"ICMP.*\"}[$__interval] offset -$__interval) or increase(hubble_drop_total{destination_namespace=~\"$namespace\", destination_app=~\"$app\", reason=\"POLICY_DENIED\", protocol!~\"ICMP.*\"}[$__interval] offset -$__interval)) > 0"
        }
      ]
    },
