  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 2,
        "current": {
          "text": "VictoriaMetrics",
          "value": "victoriametrics"
        }
      },
      {
        "name": "DS_LOGS",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "hide": 2,
        "current": {
          "text": "VictoriaLogs",
          "value": "victorialogs"
        }
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(up{job=\"blocky\"}, host)",
          "refId": "host"
        },
        "definition": "label_values(up{job=\"blocky\"}, host)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "client",
        "label": "Client",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(blocky_client_response_total{host=~\"$host\",client!=\"127.0.53.20\"}, client)",
          "refId": "client"
        },
        "definition": "label_values(blocky_client_response_total{host=~\"$host\",client!=\"127.0.53.20\"}, client)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      },
      {
        "name": "status",
        "label": "Response",
        "type": "custom",
        "query": "All : .*,Blocked : BLOCKED,Not blocked : CACHED|RESOLVED|SPECIAL|CONDITIONAL|CUSTOMDNS,Errors : err|REBIND|BOGUS",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": []
      },
      {
        "name": "domain",
        "label": "Domain regex",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter",
      "description": "Scrape availability for selected nodes.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data",
          "color": {
            "mode": "thresholds",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "axisCenteredZero": false,
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DEGRADED",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(up{job=\"blocky\",host=~\"$host\"})",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": false,
          "instant": true,
          "format": "time_series"
        }
