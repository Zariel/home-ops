          "expr": "service:\"blocky.service\" prefix:\"queryLog\" host:~\"${host:regex}\" dns_client_ip:~\"${client:regex}\" NOT dns_client_ip:=\"127.0.53.20\" dns_response_type:~\"${status:regex}\" dns_question_name:~\"${domain:raw}\" | format \"<dns_client_ip> <dns_question_name> <dns_response_type> <dns_response_code> <dns_response_reason>\" as _msg | fields _time, _msg, host, dns_client_ip, dns_client_names, dns_question_name, dns_question_type, dns_response_type, dns_response_code, dns_response_reason",
