        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(kube_pod_info{namespace=\"network\",pod=~\"bind-.*\"}, pod)",
          "refId": "pod"
        },
        "definition": "label_values(kube_pod_info{namespace=\"network\",pod=~\"bind-.*\"}, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
